# CUET ConnectX Backend - Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Connection
# Replace with your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/YOUR_DATABASE?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-characters
JWT_EXPIRE=7d

# CORS Configuration (comma-separated origins)
# For production on Render, set to your Vercel frontend URL
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
# Production example: CORS_ORIGIN=https://cuet-connectx-frontend.vercel.app

# Cloudinary (auto-parsed by SDK)
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Email Service (SendGrid HTTP API)
# Sign up at https://sendgrid.com and create an API key
EMAIL_USER=your-verified-sender@gmail.com
SENDGRID_API_KEY=your-sendgrid-api-key

# Frontend URL (used in email verification & password reset links)
FRONTEND_URL=http://localhost:5173
# Production example: FRONTEND_URL=https://cuet-connectx-frontend.vercel.app

# Backend URL (used in email templates)
BACKEND_URL=http://localhost:5000
# Production example: BACKEND_URL=https://cuet-connectx-backend-1.onrender.com

# Optional: Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
